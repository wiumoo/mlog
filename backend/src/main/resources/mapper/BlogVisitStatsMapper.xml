<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mlog.mapper.BlogVisitStatsMapper">

    <resultMap id="BlogVisitStatsResultMap" type="com.mlog.entity.BlogVisitStats">
        <id property="id" column="id"/>
        <result property="blogId" column="blog_id"/>
        <result property="statDate" column="stat_date"/>
        <result property="uv" column="uv"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="upsertDailyStats">
        INSERT INTO blog_visit_stats (
        blog_id,
        stat_date,
        uv,
        created_at,
        updated_at
        )
        VALUES (
        #{blogId},
        #{statDate},
        #{uv},
        NOW(),
        NOW()
        )
        ON DUPLICATE KEY UPDATE
        uv = VALUES(uv),
        updated_at = NOW()
    </insert>

    <select id="findByBlogIdAndDate" resultMap="BlogVisitStatsResultMap">
        SELECT
        id,
        blog_id,
        stat_date,
        uv,
        created_at,
        updated_at
        FROM blog_visit_stats
        WHERE blog_id = #{blogId}
        AND stat_date = #{statDate}
    </select>

</mapper>