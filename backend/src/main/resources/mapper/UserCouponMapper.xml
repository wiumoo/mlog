<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mlog.mapper.UserCouponMapper">

    <insert id="insert" parameterType="com.mlog.entity.UserCoupon">
        INSERT INTO user_coupon (
        event_id,
        user_id,
        status,
        created_at,
        updated_at
        )
        VALUES (
        #{eventId},
        #{userId},
        #{status},
        NOW(),
        NOW()
        )
    </insert>

</mapper>