<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mlog.mapper.UserMapper">

    <!-- Find user by id -->
    <select id="selectById" resultType="com.mlog.entity.User">
        SELECT
        id,
        phone,
        nickname,
        avatar,
        created_at AS createdAt,
        updated_at AS updateAt
        FROM user
        WHERE id = #{id}
    </select>

</mapper>